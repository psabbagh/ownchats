{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownchats",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["no_nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Every minute: retry queued comments and check watched posts for missed ones.
  "triggers": { "crons": ["* * * * *"] },
  // Optional Cloudflare Access sign-in (README, "Signing in with Cloudflare Access"). Leave both
  // empty for the password sign-in. Set ACCESS_TEAM to https://<team>.cloudflareaccess.com and
  // ACCESS_AUD to the Access app's audience tag only once the open paths app is in place.
  // PUBLIC_URL: leave empty unless the dashboard has an address of its own (README, "Signing in").
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "", "PUBLIC_URL": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownchats",
      // Left empty on purpose: Deploy to Cloudflare creates the database in your account.
      "database_id": "",
      "migrations_dir": "migrations"
    }
  ]
}
